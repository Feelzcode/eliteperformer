# Public site URL (sitemap, robots, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL="https://eliteperformerscircle.com"

# Postgres connection string (Supabase, Neon, Railway all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Admin login (single shared password — see lib/auth.js for why)
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="a-long-random-string-used-as-the-session-token"

# Cloudinary (dashboard.cloudinary.com → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (resend.com → API Keys) — for the branded confirmation email
RESEND_API_KEY=""

# EngageFoyer — workshop registration (required for homepage signup)
# Production: https://engagefoyer.com (no trailing slash, prefer apex not www)
# Local: http://localhost:3000 only when EngageFoyer is running locally
ENGAGEFOYER_APP_URL="https://engagefoyer.com"
# Live key from EngageFoyer → Settings → Registration API (ef_live_… or legacy ef_…)
ENGAGEFOYER_API_KEY=""
